# Скопируй в ai.env и заполни: cp ai.env.example ai.env && nano ai.env
# Файл ai.env в git не попадает.

# Вариант: Yandex AI Studio (OpenAI-совместимый API, работает из России)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://llm.api.cloud.yandex.net/v1
OPENAI_PROJECT=<ID каталога>
OPENAI_MODEL=gpt://<ID каталога>/yandexgpt/latest

# Вариант: любой другой OpenAI-совместимый сервис — те же переменные со своими значениями.
# Вариант: Anthropic — ANTHROPIC_API_KEY=... (и, если нужно, ANTHROPIC_MODEL=...)
